# ===========================================
# OpenClaw Command Center - SECURE Configuration
# ===========================================
# Copy this file to .env and configure your values
# NEVER commit .env to version control!
# ===========================================

# ===========================================
# SERVER CONFIGURATION
# ===========================================

# Server port (default: 3000)
PORT=3000

# Bind address - RECOMMENDED: 127.0.0.1 (localhost only)
# Use 0.0.0.0 ONLY if behind a reverse proxy with proper security
BIND_ADDRESS=127.0.0.1

# Trust proxy headers (set to 'true' if behind nginx/traefik)
TRUST_PROXY=false

# Node environment (development/production)
NODE_ENV=production

# ===========================================
# AUTHENTICATION - REQUIRED!
# ===========================================

# API Keys for authentication (comma-separated for multiple keys)
# Generate secure keys with: openssl rand -hex 32
# Example: API_KEYS=key1abc123...,key2def456...
API_KEYS=your-secure-api-key-here

# ===========================================
# CORS CONFIGURATION
# ===========================================

# Allowed origins (comma-separated)
# Example: CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3000

# ===========================================
# OPENCLAW GATEWAY
# ===========================================

# OpenClaw Gateway connection URL
GATEWAY_URL=ws://127.0.0.1:18789

# Gateway authentication token
GATEWAY_TOKEN=

# Demo mode - set to false when connected to real OpenClaw gateway
DEMO_MODE=true

# ===========================================
# VOICE PROVIDER CONFIGURATION
# ===========================================

# TTS (Text-to-Speech) provider: openai (default) | elevenlabs | gemini
# TTS_PROVIDER=openai

# STT (Speech-to-Text) provider: openai (default) | elevenlabs | gemini
# STT_PROVIDER=openai

# ===========================================
# OPENAI API (Voice - TTS/STT with OpenAI)
# ===========================================

# OpenAI API key — required when TTS_PROVIDER=openai or STT_PROVIDER=openai
# Also used by OpenAI Whisper for speech transcription
# Leave blank to disable OpenAI voice features
OPENAI_API_KEY=

# Optional: override per-agent OpenAI TTS voices
# OPENAI_VOICE_MAIN=onyx
# OPENAI_VOICE_CLAW1=echo
# OPENAI_VOICE_CLAW2=fable

# ===========================================
# ELEVENLABS API (Voice - TTS/STT with ElevenLabs)
# ===========================================

# ElevenLabs API key — required when TTS_PROVIDER=elevenlabs or STT_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=

# Optional: override per-agent ElevenLabs voice IDs
# Default voices: Adam (main) / Josh (claw-1) / Rachel (claw-2)
# Find voice IDs at: https://api.elevenlabs.io/v1/voices
# ELEVENLABS_VOICE_MAIN=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_VOICE_CLAW1=TxGEqnHWrfWFTfGW9XjX
# ELEVENLABS_VOICE_CLAW2=21m00Tcm4TlvDq8ikWAM

# ===========================================
# GEMINI API (Voice - TTS/STT with Google Gemini)
# ===========================================

# Gemini API key — required when TTS_PROVIDER=gemini or STT_PROVIDER=gemini
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override per-agent Gemini TTS voice names
# Available voices: Aoede, Charon, Fenrir, Kore, Puck, Zephyr (and more)
# Default voices: Charon (main) / Kore (claw-1) / Aoede (claw-2)
# GEMINI_VOICE_MAIN=Charon
# GEMINI_VOICE_CLAW1=Kore
# GEMINI_VOICE_CLAW2=Aoede

# ===========================================
# WEATHER WIDGET
# ===========================================

# Weather location (City,Region,Country - used by wttr.in)
WEATHER_LOCATION=Kingston,Ontario,Canada

# ===========================================
# RATE LIMITING (overrides)
# ===========================================

# Max requests per minute for general endpoints
# RATE_LIMIT_GENERAL=120

# Max requests per minute for voice endpoints (costs money!)
# RATE_LIMIT_VOICE=20

# ===========================================
# LOGGING
# ===========================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info
