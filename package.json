{
  "name": "openclaw-command-center-secure",
  "version": "2.0.0",
  "description": "OpenClaw AI Command Center for Any Platform - SECURE VERSION. Runs standalone or as an OpenClaw/NemoClaw gateway plugin.",
  "type": "module",
  "main": "server/index.js",
  "exports": {
    ".": "./server/index.js",
    "./plugin": "./nemo.plugin.js"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "lint": "eslint server/"
  },
  "nemoclaw": {
    "plugin": "./nemo.plugin.js",
    "id": "command-center",
    "basePath": "/plugins/command-center",
    "capabilities": ["http", "websocket", "ui"],
    "permissions": ["agents", "voice", "system-metrics"]
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.41.1",
    "@google/genai": "^1.48.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "multer": "^2.1.1",
    "openai": "^4.78.1",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "openclaw",
    "nemoclaw",
    "ai",
    "voice-assistant",
    "plugin",
    "secure"
  ],
  "license": "MIT"
}
